---
import { site, sections, href } from "../data/site";
import Icon from "./Icon.astro";

interface Props {
  current: string; // slug of the page being rendered
}
const { current } = Astro.props;
const here = (slug: string) => (slug === current ? "page" : undefined);
const [start, ...groups] = sections;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="34" height="34">
      <span>{site.name}</span>
    </a>

    <nav class="primary-nav" aria-label="Site">
      <ul>
        {start.pages.map((p) => (
          <li><a class="nav-link" href={href(p.slug)} aria-current={here(p.slug)}>Understanding</a></li>
        ))}
        {groups.map((group) => (
          <li>
            <details class:list={["nav-group", { "nav-group--current": group.pages.some((p) => p.slug === current) }]}>
              <summary>{group.label} <Icon name="chevron" size={16} /></summary>
              <div class:list={["nav-menu", { "nav-menu--wide": group.pages.length > 5 }]}>
                <p class="nav-menu__blurb">{group.blurb}</p>
                <ul>
                  {group.pages.map((p) => (
                    <li>
                      <a href={href(p.slug)} aria-current={here(p.slug)}>
                        <span class="nav-menu__icon"><Icon name={p.icon} /></span>
                        <span class="nav-menu__text">
                          <span class="nav-menu__label">{p.label}</span>
                          {p.hint && <span class="nav-menu__hint">{p.hint}</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="search-button" type="button" data-search-open hidden aria-label="Search the guide">
        <Icon name="search" size={18} />
        <span class="search-button__label">Search</span>
        <kbd>/</kbd>
      </button>
      <a class="urgent-link" href="/warning-signs" aria-current={here("warning-signs")}>
        <Icon name="siren" size={18} />
        <span class="urgent-link__label">Warning signs</span>
        <span class="visually-hidden">(urgent symptoms)</span>
      </a>
      <details class="mobile-nav">
        <summary aria-label="Menu">
          <Icon name="menu" class="icon-menu" />
          <Icon name="close" class="icon-close" />
        </summary>
        <nav class="mobile-nav__panel" aria-label="Site">
          <ul>
            <li><a href="/" aria-current={here("index")}><Icon name="house" />Home</a></li>
          </ul>
          {sections.map((section) => (
            <>
              <h2>{section.label}</h2>
              <ul>
                {section.pages.map((p) => (
                  <li><a href={href(p.slug)} aria-current={here(p.slug)}><Icon name={p.icon} />{p.label}</a></li>
                ))}
              </ul>
            </>
          ))}
        </nav>
      </details>
    </div>
  </div>
</header>
