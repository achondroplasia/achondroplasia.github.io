---
import { inlineMarkdown } from "../lib/markdown";
import Icon from "./Icon.astro";

interface Props {
  intro?: string;
  items: string[];
  lastReviewed?: Date;
}
const { intro, items, lastReviewed } = Astro.props;
const reviewed = lastReviewed?.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
---
<section class="sources" aria-labelledby="sources">
  <h2 id="sources"><Icon name="sources" /> Sources</h2>
  {intro && <p>{intro}</p>}
  <ol>
    {items.map((item) => <li set:html={inlineMarkdown(item)} />)}
  </ol>
  {reviewed && <p class="updated">Content last reviewed: {reviewed}.</p>}
</section>
