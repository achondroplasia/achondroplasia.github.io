---
import Figure from "./Figure.astro";

/* A small multi-series line chart drawn at build time. Series are told
   apart by line style and marker shape as well as colour, are labelled
   at their line ends, and the numbers are given in a table underneath. */
interface Series {
  name: string;
  points: [number, number][];
  style?: "solid" | "dashed";
}
interface Props {
  caption: string;
  credit?: string;
  series: Series[];
  x: { min: number; max: number; ticks: number[]; label: string; unit: string };
  y: { min: number; max: number; ticks: number[]; unit: string };
  /** Optional shaded x-range with a label, e.g. a placebo period */
  band?: { from: number; to: number; label: string };
}
const { caption, credit, series, x, y, band } = Astro.props;

const W = 380, H = 260;
const M = { top: 26, right: 118, bottom: 44, left: 40 };
const sx = (v: number) => M.left + ((v - x.min) / (x.max - x.min)) * (W - M.left - M.right);
const sy = (v: number) => H - M.bottom - ((v - y.min) / (y.max - y.min)) * (H - M.top - M.bottom);
const path = (pts: [number, number][]) => "M" + pts.map(([a, b]) => `${sx(a).toFixed(1)},${sy(b).toFixed(1)}`).join("L");

/* End labels, nudged apart */
const ends = series.map((s, i) => ({ i, y: sy(s.points[s.points.length - 1][1]) })).sort((a, b) => a.y - b.y);
for (let k = 1; k < ends.length; k++) ends[k].y = Math.max(ends[k].y, ends[k - 1].y + 15);
const endY = Object.fromEntries(ends.map((e) => [e.i, e.y]));
const xs = [...new Set(series.flatMap((s) => s.points.map((p) => p[0])))].sort((a, b) => a - b);
const summary = series
  .map((s) => `${s.name}: ` + s.points.map(([a, b]) => `${b} ${y.unit} at ${a} ${x.unit}`).join(", "))
  .join(". ");
---
<Figure caption={caption} credit={credit} details="Show the numbers">
  <svg class="linechart" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary}>
    {band && <rect class="linechart__band" x={sx(band.from)} y={M.top} width={sx(band.to) - sx(band.from)} height={H - M.top - M.bottom} />}
    {band && <text class="chart__tick" x={sx(band.from) + 6} y={M.top + 16}>{band.label}</text>}
    {y.ticks.map((v) => (
      <g>
        <line class="chart__grid" x1={M.left} x2={W - M.right} y1={sy(v)} y2={sy(v)} />
        <text class="chart__tick" x={M.left - 6} y={sy(v)} text-anchor="end" dominant-baseline="middle">{v}</text>
      </g>
    ))}
    {x.ticks.map((v) => <text class="chart__tick" x={sx(v)} y={H - M.bottom + 17} text-anchor="middle">{v}</text>)}
    <text class="chart__tick" x={M.left - 6} y={M.top - 8} text-anchor="end">{y.unit}</text>
    <text class="chart__axis-title" x={(M.left + W - M.right) / 2} y={H - 6} text-anchor="middle">{x.label}</text>
    {series.map((s, i) => (
      <g class={`linechart__series linechart__series--${i}`}>
        <path class={`linechart__line${s.style === "dashed" ? " linechart__line--dashed" : ""}`} d={path(s.points)} />
        {s.points.map(([a, b]) =>
          i % 2 === 0 ? <circle class="linechart__mark" cx={sx(a)} cy={sy(b)} r="4.5" /> : <rect class="linechart__mark" x={sx(a) - 4} y={sy(b) - 4} width="8" height="8" />
        )}
        <text class="chart__label linechart__end" x={sx(s.points[s.points.length - 1][0]) + 9} y={endY[i]} dominant-baseline="middle">{s.name}</text>
      </g>
    ))}
  </svg>
  <div slot="details" class="table-wrap" tabindex="0" role="region" aria-label="Table: chart numbers">
    <table>
      <thead>
        <tr>
          <th scope="col">{x.label}</th>
          {series.map((s) => <th scope="col">{s.name} ({y.unit})</th>)}
        </tr>
      </thead>
      <tbody>
        {xs.map((xv) => (
          <tr>
            <th scope="row">{xv}</th>
            {series.map((s) => <td>{s.points.find((p) => p[0] === xv)?.[1] ?? "–"}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Figure>
