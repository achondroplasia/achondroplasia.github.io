---
import { getCollection, render } from "astro:content";
import Page from "../layouts/Page.astro";
import Callout from "../components/Callout.astro";
import Grid from "../components/Grid.astro";
import Card from "../components/Card.astro";
import LinkCard from "../components/LinkCard.astro";
import AgeBand from "../components/AgeBand.astro";
import Facts from "../components/Facts.astro";
import Fact from "../components/Fact.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeIntro from "../components/HomeIntro.astro";
import StartPaths from "../components/StartPaths.astro";
import Directory from "../components/Directory.astro";
import Figure from "../components/Figure.astro";
import GrowthChart from "../components/GrowthChart.astro";
import GrowthBrake from "../components/GrowthBrake.astro";
import PeopleArray from "../components/PeopleArray.astro";
import InheritanceChances from "../components/InheritanceChances.astro";
import CareTimeline from "../components/CareTimeline.astro";
import AfmsLadder from "../components/AfmsLadder.astro";
import UrgencyLadder from "../components/UrgencyLadder.astro";
import TrialResults from "../components/TrialResults.astro";
import MilestoneRanges from "../components/MilestoneRanges.astro";
import SafeSeating from "../components/SafeSeating.astro";
import SpinalCanal from "../components/SpinalCanal.astro";
import GuidedGrowth from "../components/GuidedGrowth.astro";
import LimbLengthening from "../components/LimbLengthening.astro";
import DiagnosisRoutes from "../components/DiagnosisRoutes.astro";
import ComplicationRates from "../components/ComplicationRates.astro";
import Steps from "../components/Steps.astro";
import Cards from "../components/Cards.astro";
import Bars from "../components/Bars.astro";
import Heatmap from "../components/Heatmap.astro";
import Intervals from "../components/Intervals.astro";
import LineChart from "../components/LineChart.astro";
import SettingSun from "../components/SettingSun.astro";
import StenosisPosture from "../components/StenosisPosture.astro";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const components = { Callout, Grid, Card, LinkCard, AgeBand, Facts, Fact, HomeHero, HomeIntro, StartPaths, Directory, Figure, GrowthChart, GrowthBrake, PeopleArray, InheritanceChances, CareTimeline, AfmsLadder, UrgencyLadder, TrialResults, MilestoneRanges, SafeSeating, SpinalCanal, GuidedGrowth, LimbLengthening, DiagnosisRoutes, ComplicationRates, Steps, Cards, Bars, Heatmap, Intervals, LineChart, SettingSun, StenosisPosture };
---
<Page entry={entry} headings={headings}>
  <Content components={components} />
</Page>
