---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { site, href } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sources from "../components/Sources.astro";
import PageNav from "../components/PageNav.astro";
import "../styles/global.css";

interface Props {
  entry: CollectionEntry<"pages">;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const page = entry.data;
const slug = entry.id;
const path = href(slug);
const url = site.url + path;
const title = page.headTitle ?? `${page.title} · ${site.name}`;
const ogDescription = page.ogDescription ?? page.description;
const twitterDescription = page.twitterDescription ?? ogDescription;
const ogType = slug === "index" || slug === "404" ? "website" : "article";
const toc = page.toc ? headings.filter((h) => h.depth === 2) : [];

const jsonLd = slug !== "404" && {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: page.title,
  description: page.description,
  url: slug === "index" ? site.url + "/" : url,
  inLanguage: "en",
  audience: { "@type": "MedicalAudience", audienceType: "Patient" },
  about: {
    "@type": "MedicalCondition",
    name: "Achondroplasia",
    code: { "@type": "MedicalCode", codeValue: "Q77.4", codingSystem: "ICD-10" },
    alternateName: "Dwarfism, achondroplastic",
    url: "https://medlineplus.gov/genetics/condition/achondroplasia/",
  },
  publisher: { "@type": "Person", name: site.author, url: site.url },
  dateModified: page.lastReviewed?.toISOString().slice(0, 10),
  keywords: page.keywords,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={page.description}>
  <link rel="canonical" href={slug === "index" ? site.url + "/" : url}>
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={slug === "index" ? site.url + "/" : url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:site_name" content={site.name}>
  <meta property="og:image" content={`${site.url}/og-image.jpg`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={twitterDescription}>
  <meta name="twitter:image" content={`${site.url}/og-image.jpg`}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header current={path} />

  <div class={toc.length ? "page page--with-toc" : "page"}>
    <main id="main">
      {/* Pages without a lede (the home page) open with their own <Hero>. */}
      {page.lede && <h1>{page.heading ?? page.title}</h1>}
      {page.lede && <p class="lede">{page.lede}</p>}
      <slot />
      {page.sources && <Sources {...page.sources} lastReviewed={page.lastReviewed} />}
      <PageNav slug={slug} />
    </main>

    {toc.length > 0 && (
      <nav class="toc" aria-label="On this page">
        <h2>On this page</h2>
        <ul>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ul>
      </nav>
    )}
  </div>

  <Footer />
  <script src="../scripts/site.js"></script>
</body>
</html>
