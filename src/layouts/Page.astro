---
import type { CollectionEntry } from "astro:content";
import type { MarkdownHeading } from "astro";
import { site, href, findPage } from "../data/site";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sources from "../components/Sources.astro";
import PageNav from "../components/PageNav.astro";
import Toc from "../components/Toc.astro";
import SearchDialog from "../components/SearchDialog.astro";
import Icon from "../components/Icon.astro";
import "../styles/global.css";

interface Props {
  entry: CollectionEntry<"pages">;
  headings: MarkdownHeading[];
}
const { entry, headings } = Astro.props;
const page = entry.data;
const slug = entry.id;
const isHome = slug === "index";
const path = href(slug);
const url = isHome ? site.url + "/" : site.url + path;
const title = page.headTitle ?? `${page.title} · ${site.name}`;
const ogDescription = page.ogDescription ?? page.description;
const twitterDescription = page.twitterDescription ?? ogDescription;
const ogType = isHome || slug === "404" ? "website" : "article";
const showToc = page.toc && headings.some((h) => h.depth === 2);
const placement = findPage(slug);

const reviewed = page.lastReviewed?.toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
const words = (entry.body ?? "").split(/\s+/).length;
const minutes = Math.max(1, Math.round(words / 230));

const jsonLd = slug !== "404" && {
  "@context": "https://schema.org",
  "@type": "MedicalWebPage",
  name: page.title,
  description: page.description,
  url,
  inLanguage: "en",
  audience: { "@type": "MedicalAudience", audienceType: "Patient" },
  about: {
    "@type": "MedicalCondition",
    name: "Achondroplasia",
    code: { "@type": "MedicalCode", codeValue: "Q77.4", codingSystem: "ICD-10" },
    alternateName: "Dwarfism, achondroplastic",
    url: "https://medlineplus.gov/genetics/condition/achondroplasia/",
  },
  publisher: { "@type": "Person", name: site.author, url: site.url },
  dateModified: page.lastReviewed?.toISOString().slice(0, 10),
  keywords: page.keywords,
};
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={page.description}>
  <link rel="canonical" href={url}>
  <meta name="theme-color" content="#fbf9f5" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#0f161b" media="(prefers-color-scheme: dark)">
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={url}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:site_name" content={site.name}>
  <meta property="og:image" content={`${site.url}/og-image.jpg`}>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={twitterDescription}>
  <meta name="twitter:image" content={`${site.url}/og-image.jpg`}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />}
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header current={slug} />

  <div class:list={["page", { "page--with-toc": showToc, "page--home": isHome }]}>
    <main id="main" data-pagefind-body={slug === "404" ? undefined : ""}>
      {/* Pages without a lede (the home page) open with their own hero. */}
      {page.lede && (
        <div class="page-head">
          <nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
            <ol>
              <li><a href="/">Home</a></li>
              {placement && <li>{placement.section.label}</li>}
            </ol>
          </nav>
          {placement && (
            <p class="page-kicker" data-pagefind-ignore>
              <span class="page-kicker__icon"><Icon name={placement.page.icon} /></span>
              {placement.section.label}
            </p>
          )}
          <h1 data-pagefind-meta="title">{page.heading ?? page.title}</h1>
          <p class="lede">{page.lede}</p>
          {page.sources && (
            <ul class="page-meta" data-pagefind-ignore>
              {reviewed && <li><Icon name="reviewed" size={17} /> Reviewed {reviewed}</li>}
              <li><Icon name="clock" size={17} /> {minutes} min read</li>
              <li><Icon name="sources" size={17} /> <a href="#sources">{page.sources.items.length} sources</a></li>
            </ul>
          )}
        </div>
      )}
      {showToc && <Toc headings={headings} variant="inline" hasSources={!!page.sources} />}
      <slot />
      {page.sources && <Sources {...page.sources} lastReviewed={page.lastReviewed} />}
      <PageNav slug={slug} />
    </main>

    {showToc && <Toc headings={headings} variant="sidebar" hasSources={!!page.sources} />}
  </div>

  <Footer />
  <SearchDialog />
  <script src="../scripts/site.js"></script>
</body>
</html>
